#!/sbin/openrc-run
# The Cloudflare tunnel connector.
#
# `cloudflared service install` writes a sysvinit script that OpenRC cannot
# supervise and that carries the tunnel token in a world-readable file. This is
# the same connector, run under supervise-daemon, with the token in
# /etc/conf.d/cloudflared where it can be kept to mode 0600.

description="Cloudflare tunnel connector"

: "${cloudflared_opts:=--no-autoupdate}"

supervisor="supervise-daemon"
command="/usr/bin/cloudflared"
command_args="${cloudflared_opts} tunnel run"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"
respawn_delay=5
respawn_max=0

depend() {
	need net
	after gentstore-website
	use logger
}

start_pre() {
	if [ -z "${TUNNEL_TOKEN}" ]; then
		eerror "TUNNEL_TOKEN is not set in /etc/conf.d/${RC_SVCNAME}"
		eerror "It is the token the Cloudflare dashboard showed when the tunnel"
		eerror "was created; that file should be root-owned and mode 0600."
		return 1
	fi
	export TUNNEL_TOKEN
	checkpath --file --mode 0640 "${output_log}"
}
