#!/sbin/openrc-run
# GentStore website — the uvicorn process behind the Cloudflare tunnel.
#
# Everything tunable lives in /etc/conf.d/gentstore-website. The service runs as
# an ordinary user and binds the loopback only: the tunnel is the one way in, so
# nothing else on the machine or the local network can reach it directly.

description="GentStore website"

: "${website_root:=/opt/gentstore/website}"
: "${website_user:=gentstore}"
: "${website_host:=127.0.0.1}"
: "${website_port:=8000}"
: "${website_workers:=2}"

# The application reads this to write absolute canonical and preview URLs.
# Unset, it falls back to relative ones, which are correct but tell a crawler
# less.
[ -n "${website_base_url}" ] && export GENTSTORE_WEB_BASE_URL="${website_base_url}"

supervisor="supervise-daemon"
directory="${website_root}"
command="${website_root}/.venv/bin/python"
command_args="-m uvicorn app.main:app
	--host ${website_host}
	--port ${website_port}
	--workers ${website_workers}
	--proxy-headers
	--forwarded-allow-ips 127.0.0.1"
command_user="${website_user}"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"
respawn_delay=5
respawn_max=0

depend() {
	need net
	use logger
}

start_pre() {
	if [ ! -x "${command}" ]; then
		eerror "No interpreter at ${command}"
		eerror "Create the virtualenv first, as ${website_user}:"
		eerror "  python -m venv ${website_root}/.venv"
		eerror "  ${website_root}/.venv/bin/pip install -r ${website_root}/requirements.txt"
		return 1
	fi
	checkpath --file --owner "${website_user}" --mode 0644 "${output_log}"
}
